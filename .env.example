# =============================================================================
# Resume AI Builder — Environment Configuration (Example)
# =============================================================================
# Copy this file to .env and fill in the placeholder values.
#
# See AZURE_SETUP.md for step-by-step Azure provisioning instructions.
# =============================================================================

# ---------------------------------------------------------------------------
# Gemini API (Google AI Studio)
# ---------------------------------------------------------------------------
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Model: gemini-2.5-pro (best quality) or gemini-2.5-flash (faster/cheaper)
GEMINI_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------------------
# Azure CosmosDB for PostgreSQL (Flexible Server)
# ---------------------------------------------------------------------------
# Connection string format for asyncpg (SSL required by Azure):
#   postgresql://USERNAME:PASSWORD@HOSTNAME:5432/DATABASE?sslmode=require
#
# IMPORTANT: If your password contains special characters (@, :, /, %, #, etc.),
# they MUST be URL-encoded:
#   @ → %40   : → %3A   / → %2F   % → %25   # → %23
#
# Set EITHER this or DATABASE_URL:
AZURE_COSMOSDB_PG_URL=
# Or use the legacy variable name:
# DATABASE_URL=postgresql://resume:resume@localhost:5432/resume

# ---------------------------------------------------------------------------
# Azure Blob Storage — Resume Archive & Templates
# ---------------------------------------------------------------------------
# Get the connection string from:
#   Azure Portal → Storage Account → Security + networking → Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=resume-archive

# Master template path (read-only, manually uploaded once)
TEMPLATE_BLOB_PATH=templates/master_resume.tex

# ---------------------------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# bcrypt hash of the passcode. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSCODE', bcrypt.gensalt()).decode())"
AUTH_PASSCODE_HASH=$2b$12$replace_with_your_bcrypt_hash

# ---------------------------------------------------------------------------
# Database Pool (connection limits based on Azure tier)
# ---------------------------------------------------------------------------
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# ---------------------------------------------------------------------------
# LangGraph / LaTeX / Caching
# ---------------------------------------------------------------------------
SESSION_TTL_HOURS=6
LANGGRAPH_CHECKPOINT_TABLE=langgraph_checkpoints
PDFLATEX_TIMEOUT_SECONDS=30
LATEX_FIX_MAX_RETRIES=2
PROJECT_BULLET_CACHE_TTL_DAYS=90
DRAFT_CACHE_TTL_DAYS=7
