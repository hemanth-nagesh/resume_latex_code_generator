# =============================================================================
# Resume AI Builder — Environment Configuration (Example)
# =============================================================================
# Copy this file to .env and fill in the placeholder values.
#
# Stack: Northflank (hosting) + Supabase (Postgres). There is no separate
# blob/object storage — generated PDFs and LaTeX source are stored directly
# in the `sessions` table (see server/db/migrations/002_*.sql).
# =============================================================================

# ---------------------------------------------------------------------------
# Gemini API (Google AI Studio)
# ---------------------------------------------------------------------------
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Model: gemini-2.5-pro (best quality) or gemini-2.5-flash (faster/cheaper)
GEMINI_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------------------
# PostgreSQL (Supabase)
# ---------------------------------------------------------------------------
# Get this from: Supabase Dashboard → Project Settings → Database →
# Connection string → URI (use the "Session pooler" or "Transaction pooler"
# connection string for serverless/containerized deployments).
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#
# IMPORTANT: If your password contains special characters (@, :, /, %, #, etc.),
# they MUST be URL-encoded:
#   @ → %40   : → %3A   / → %2F   % → %25   # → %23
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# bcrypt hash of the passcode. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSCODE', bcrypt.gensalt()).decode())"
AUTH_PASSCODE_HASH=$2b$12$replace_with_your_bcrypt_hash

# ---------------------------------------------------------------------------
# Database Pool (Supabase pooler connection limits)
# ---------------------------------------------------------------------------
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# ---------------------------------------------------------------------------
# LangGraph / LaTeX / Caching
# ---------------------------------------------------------------------------
SESSION_TTL_HOURS=6
LANGGRAPH_CHECKPOINT_TABLE=langgraph_checkpoints
PDFLATEX_TIMEOUT_SECONDS=30
LATEX_FIX_MAX_RETRIES=2
PROJECT_BULLET_CACHE_TTL_DAYS=90
DRAFT_CACHE_TTL_DAYS=7

# ---------------------------------------------------------------------------
# LaTeX MCP — external LaTeX → PDF compilation server
# ---------------------------------------------------------------------------
# See custom_latex_mcp.md. We call the plain REST endpoint (no MCP SDK needed):
#   POST {LATEX_MCP_URL}/api/convert   with header X-API-Key
LATEX_MCP_URL=http://20.212.83.231
LATEX_MCP_API_KEY=your-mcp-api-key-here
LATEX_MCP_TIMEOUT_SECONDS=30
LATEX_MCP_MAX_RETRIES=2
